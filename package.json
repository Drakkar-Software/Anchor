{
  "name": "@drakkar.software/anchor-monorepo",
  "private": true,
  "packageManager": "pnpm@10.25.0",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "clean": "pnpm -r clean",
    "publish:all": "pnpm build && pnpm -r publish",
    "publish:all:dry": "pnpm build && pnpm -r publish --dry-run"
  },
  "engines": {
    "node": ">=22"
  }
}
