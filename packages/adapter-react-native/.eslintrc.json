{
  "root": true,
  "extends": [
    "hardcore",
    "hardcore/ts",
    "../../eslint-hardcore-shared.cjs"
  ],
  "parserOptions": {
    "project": "./tsconfig.eslint.json"
  },
  "env": {
    "es2022": true
  },
  "ignorePatterns": [
    "dist/",
    "coverage/",
    "node_modules/"
  ],
  "overrides": [
    {
      "files": ["tsup.config.ts", "vitest.config.ts"],
      "extends": ["hardcore/node"],
      "env": {
        "node": true
      },
      "rules": {
        "n/no-missing-import": "off",
        "n/no-unpublished-import": "off",
        "import/no-unresolved": "off",
        "import/no-extraneous-dependencies": "off",
        "strict": "off"
      }
    },
    {
      "files": ["**/*.{test,spec}.ts", "**/__tests__/**/*"],
      "env": {
        "jest": true
      }
    }
  ]
}
