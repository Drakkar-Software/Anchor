{
  "name": "@drakkar.software/anchor",
  "version": "3.2.0",
  "description": "Anchor: auto-generated Zustand stores for Supabase, offline-first, realtime, type-safe",
  "repository": {
    "type": "git",
    "url": "https://github.com/Drakkar-Software/Anchor",
    "directory": "packages/core"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./hooks": {
      "types": "./dist/hooks/index.d.ts",
      "import": "./dist/hooks/index.mjs",
      "require": "./dist/hooks/index.js"
    },
    "./client": {
      "types": "./dist/client/createClient.d.ts",
      "import": "./dist/client/createClient.mjs",
      "require": "./dist/client/createClient.js"
    },
    "./query": {
      "types": "./dist/query/filters.d.ts",
      "import": "./dist/query/filters.mjs",
      "require": "./dist/query/filters.js"
    },
    "./query/queryBuilder": {
      "types": "./dist/query/queryBuilder.d.ts",
      "import": "./dist/query/queryBuilder.mjs",
      "require": "./dist/query/queryBuilder.js"
    },
    "./query/pagination": {
      "types": "./dist/query/pagination.d.ts",
      "import": "./dist/query/pagination.mjs",
      "require": "./dist/query/pagination.js"
    },
    "./auth": {
      "types": "./dist/auth/authStore.d.ts",
      "import": "./dist/auth/authStore.mjs",
      "require": "./dist/auth/authStore.js"
    },
    "./auth/callbacks": {
      "types": "./dist/auth/authCallbacks.d.ts",
      "import": "./dist/auth/authCallbacks.mjs",
      "require": "./dist/auth/authCallbacks.js"
    },
    "./auth/gate": {
      "types": "./dist/auth/authGate.d.ts",
      "import": "./dist/auth/authGate.mjs",
      "require": "./dist/auth/authGate.js"
