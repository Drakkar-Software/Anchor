      "types": "./dist/auth/authActions.d.ts",
      "import": "./dist/auth/authActions.mjs",
      "require": "./dist/auth/authActions.js"
    },
    "./functions": {
      "types": "./dist/functions/edgeFunctions.d.ts",
      "import": "./dist/functions/edgeFunctions.mjs",
      "require": "./dist/functions/edgeFunctions.js"
    },
    "./storage": {
      "types": "./dist/storage/storageActions.d.ts",
      "import": "./dist/storage/storageActions.mjs",
      "require": "./dist/storage/storageActions.js"
    },
    "./storage/storageActions": {
      "types": "./dist/storage/storageActions.d.ts",
      "import": "./dist/storage/storageActions.mjs",
      "require": "./dist/storage/storageActions.js"
