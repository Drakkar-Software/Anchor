{
  "name": "@drakkar.software/anchor-adapter-web",
  "version": "3.1.0",
  "description": "Web platform adapters for Anchor (localStorage, IndexedDB)",
  "repository": {
    "type": "git",
    "url": "https://github.com/Drakkar-Software/Anchor",
    "directory": "packages/adapter-web"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --ext .ts,.tsx,.js,.cjs,.mjs .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@drakkar.software/anchor": ">=3.0.0"
  },
  "devDependencies": {
    "@drakkar.software/anchor": "workspace:*",
    "jsdom": "^30.0.1",
    "tsup": "^8.0.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT"
}
